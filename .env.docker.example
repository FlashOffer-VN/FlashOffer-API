# .env.docker.example - Mẫu cấu hình Docker
# Copy thành .env.docker và sửa giá trị thật

DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=FlashOfferDb;Username=postgres;Password=postgres;SSL Mode=Prefer
JWT_SECRET=YourSuperSecretKeyHereAtLeast32CharactersLong!
JWT_ISSUER=FlashOffer.API
JWT_AUDIENCE=FlashOffer.APIClient
JWT_EXPIRY_MINUTES=60
LOG_LEVEL=Information
POSTGRES_PASSWORD=YourStrong!Passw0rd
POSTGRES_DB=FlashOfferDb
POSTGRES_USER=postgres
