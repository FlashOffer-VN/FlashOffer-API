{
    "ConnectionStrings": {
        "DefaultConnection": "Host=<DB_HOST>;Port=5432;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true;"
    },
    "JwtSettings": {
        "Secret": "<JWT_SECRET_32_CHARS_MIN>",
        "Issuer": "FlashOfferAPI",
        "Audience": "FlashOfferClient",
        "ExpiryMinutes": 60
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "CorsSettings": {
        "Policy": "AllowSpecific",
        "AllowedOrigins": "https://staging.kindi.vn/,https://www.kindi.vn/"
    },
    "EnableSwagger": true
}
