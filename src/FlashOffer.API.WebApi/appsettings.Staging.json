{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_STAGING_SERVER;Database=FlashOffer.APIDb_Staging;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "JwtSettings": {
    "Secret": "STAGING_SECRET_KEY_MUST_BE_32_CHARS_OR_MORE!",
    "Issuer": "FlashOffer.API_Staging",
    "Audience": "FlashOffer.APIClient_Staging",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
